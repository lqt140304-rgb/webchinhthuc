{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tai-khoan/(.*)",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/cau-chuyen/(.*)",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/bai-viet/(.*)",
      "destination": "/__spa-fallback.html"
    }
  ]
}
