# ==============================================================================
# GITATTRIBUTES — BỆNH VIỆN THÚ Y LÊ SƠN 2026
# Standardize line endings to LF across OS environments (Windows / Linux CI)
# Preserves exact binary bytes for fonts, images, and media assets
# ==============================================================================

# Default rule: Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit source code & web text assets
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.sh text eol=lf
*.psv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary assets — strictly preserve byte-for-byte integrity without modification
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
